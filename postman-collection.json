            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentDate\": \"2026-07-20T11:00:00\",\n  \"reason\": \"Updated appointment reason\",\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{id}}"]
            }
          }
        },
        {
          "name": "Delete Appointment",
          "request": {
            "method": "DELETE",
