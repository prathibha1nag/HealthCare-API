              "path": ["api", "appointments", "{{id}}"]
            }
          }
        },
        {
          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": 1,\n  \"patientId\": 1,\n  \"appointmentDate\": \"2026-07-20T10:00:00\",\n  \"reason\": \"Regular checkup\",\n  \"status\": \"SCHEDULED\"\n}"
            },
